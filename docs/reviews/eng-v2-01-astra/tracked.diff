-    const saved = window.localStorage.getItem(STORAGE_KEY) as ThemePreference | null;
-    return saved && allowedPreferences.includes(saved) ? saved : 'system';
-  } catch {
-    return 'system';
-  }
-}
-
-function getSystemTheme(): ResolvedTheme {
