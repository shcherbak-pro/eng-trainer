+.storage-notice small { display: block; margin-top: 4px; }
+.app-footer { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 28px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 0.9rem; }
+.app-footer a { color: inherit; font-weight: 700; }
