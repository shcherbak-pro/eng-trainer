-/** Lower-cased text without punctuation, used to recognise the same item twice. */
-export function normalizeTerm(value: unknown): string {
-  return String(value ?? '')
-    .toLowerCase()
-    .replace(/[^\p{L}\p{N}]+/gu, ' ')
-    .trim();
-}
