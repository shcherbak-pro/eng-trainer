{
  "name": "english-assessment-trainer-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "content:generate": "node scripts/generate-content.mjs",
    "content:generate:v3": "node scripts/generate-content.mjs experimental-v3",
    "predev": "npm run content:generate",
    "dev": "vite",
    "dev:v3": "node scripts/product-run.mjs experimental-v3 dev",
    "prebuild": "npm run content:generate",
    "build": "vite build",
    "build:v3": "node scripts/product-run.mjs experimental-v3 build",
    "preview": "vite preview",
    "precheck": "npm run content:generate",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "pretest": "npm run content:generate",
    "test": "node --test scripts/content-build.test.mjs scripts/site-config.test.mjs scripts/generated-dirs.test.mjs scripts/safe-destinations.test.mjs scripts/build-destinations.test.mjs scripts/product-content.test.mjs scripts/product-gates.test.mjs scripts/pronunciation-policy.test.mjs scripts/prototype/prototype.test.mjs && vitest run",
    "test:v3": "node scripts/product-run.mjs experimental-v3 test",
    "verify:content": "node scripts/verify-content-migration.mjs",
    "install:v1": "npm --prefix v1 ci",
    "dev:v1": "npm --prefix v1 run dev",
    "check:v1": "npm --prefix v1 run check",
    "test:v1": "npm --prefix v1 run test",
    "build:v1": "npm --prefix v1 run build",
    "assemble": "node scripts/assemble-site.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:products": "node scripts/check-products.mjs",
    "check:negative": "node scripts/check-negative.mjs",
    "assemble:test": "node scripts/assemble-test-site.mjs && node scripts/check-site.mjs --test",
    "rehearse:promotion": "node scripts/rehearse-promotion.mjs",
    "prototype:model": "node scripts/prototype/fetch-model.mjs",
    "prototype:build": "npm run build:site && npm run build:v3 && npm run assemble:test",
    "prototype:serve": "node scripts/prototype/server.mjs",
    "build:site": "npm run build && npm run build:v1 && npm run assemble && npm run check:site"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "onnxruntime-web": "1.31.1"
  }
}
