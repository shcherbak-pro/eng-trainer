{
  "name": "english-assessment-trainer-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "content:generate": "node scripts/generate-content.mjs",
    "predev": "npm run content:generate",
    "dev": "vite",
    "prebuild": "npm run content:generate",
    "build": "vite build",
    "preview": "vite preview",
    "precheck": "npm run content:generate",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "pretest": "npm run content:generate",
    "test": "node --test scripts/content-build.test.mjs && vitest run",
    "verify:content": "node scripts/verify-content-migration.mjs",
    "install:v1": "npm --prefix v1 ci",
    "dev:v1": "npm --prefix v1 run dev",
    "check:v1": "npm --prefix v1 run check",
    "test:v1": "npm --prefix v1 run test",
    "build:v1": "npm --prefix v1 run build",
    "assemble": "node scripts/assemble-site.mjs",
    "check:site": "node scripts/check-site.mjs",
    "build:site": "npm run build && npm run build:v1 && npm run assemble && npm run check:site"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "idb": "^8.0.4"
  }
}
